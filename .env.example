# Clé API Google AI Studio : https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optionnel — modèle Gemini (défaut : gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Optionnel — serveur PlantUML (défaut : https://www.plantuml.com/plantuml)
# Pointez-le vers une instance auto-hébergée pour garder vos diagrammes en interne.
# PLANTUML_SERVER=http://localhost:8080
